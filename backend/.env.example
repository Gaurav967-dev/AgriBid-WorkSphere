# AgriBid WorkSphere Backend - Example configuration
# Copy to backend/.env and replace placeholders locally.
# Never commit backend/.env.

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/agribid_worksphere

JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=5242880
