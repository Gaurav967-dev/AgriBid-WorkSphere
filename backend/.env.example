# AgriBid WorkSphere backend configuration.
# Copy this file to .env and replace local placeholders.
# Never commit .env.

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/agribid_worksphere

CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

COOKIE_SECURE=false

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

JWT_ISSUER=agribid-worksphere
JWT_AUDIENCE=agribid-worksphere-api
ID_TOKEN_EXPIRE_MINUTES=5

INVITATION_EXPIRE_DAYS=7
FRONTEND_BASE_URL=http://localhost:3000